{
  "_comment": "USB devkit FNT-000001 (test device). CAUTION: the IP is DHCP-dynamic — check it before every run! NEVER enter 192.168.1.51, that is the PRODUCTION PUMP. Start: CLIENT_CONFIG=/app/config/client.fnt-000001.json docker compose up client",

  "device": {
    "host": "192.168.1.101",
    "port": 4443,
    "path": "/ws",
    "websocket_subprotocol": "fountain"
  },

  "tls": {
    "ca_file": "/certs/root/certs/ca.crt.pem",
    "client_cert_file": "/certs/clients/service-laptop-01.crt",
    "client_key_file": "/certs/clients/service-laptop-01.key",
    "verify_peer": true,
    "use_mtls": true,
    "verify_hostname": false
  },

  "connection": {
    "auto_reconnect": true,
    "connect_timeout_s": 10,
    "reconnect_initial_s": 1,
    "reconnect_max_s": 30
  },

  "logging": {
    "level": "info"
  },

  "fountain": {
    "device_id": "fnt-000001",
    "serial": "00464E5400000001",
    "kid": "1",
    "hmac_key_file": "/secrets/FNT-000001/hmac.key",
    "handshake_timeout_s": 15,
    "dp_read_on_ready": true
  }
}
