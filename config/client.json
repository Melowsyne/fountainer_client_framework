{
  "_comment": "TEMPLATE — host is deliberately a placeholder. For the USB devkit use config/client.fnt-000001.json. NEVER enter the production pump (192.168.1.51)!",

  "device": {
    "host": "ENTER-DEVICE-IP.invalid",
    "port": 4443,
    "path": "/ws",
    "websocket_subprotocol": "fountain"
  },

  "tls": {
    "ca_file": "/certs/root/certs/ca.crt.pem",
    "client_cert_file": "/certs/clients/service-laptop-01.crt",
    "client_key_file": "/certs/clients/service-laptop-01.key",
    "verify_peer": true,
    "use_mtls": true,
    "verify_hostname": false
  },

  "connection": {
    "auto_reconnect": true,
    "connect_timeout_s": 10,
    "reconnect_initial_s": 1,
    "reconnect_max_s": 30
  },

  "logging": {
    "level": "info"
  }
}
