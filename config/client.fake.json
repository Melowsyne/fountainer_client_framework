{
  "_comment": "Integration test against tools/fake_device.py (host IP 192.168.1.12:4444). Start: python3 tools/fake_device.py --port 4444 --ca ... --cert ... --key ...",

  "device": {
    "host": "192.168.1.12",
    "port": 4444,
    "path": "/ws",
    "websocket_subprotocol": "fountain"
  },

  "tls": {
    "ca_file": "/certs/root/certs/ca.crt.pem",
    "client_cert_file": "/certs/clients/service-laptop-01.crt",
    "client_key_file": "/certs/clients/service-laptop-01.key",
    "verify_peer": true,
    "use_mtls": true,
    "verify_hostname": false
  },

  "connection": {
    "auto_reconnect": true,
    "connect_timeout_s": 10,
    "reconnect_initial_s": 1,
    "reconnect_max_s": 30
  },

  "logging": {
    "level": "info"
  },

  "fountain": {
    "device_id": "esp32-fake01",
    "serial": "000001C0C01FA82A",
    "kid": "1",
    "hmac_key_file": "/app/test/fixtures/fake_device.hmac",
    "handshake_timeout_s": 15,
    "dp_read_on_ready": true
  }
}
