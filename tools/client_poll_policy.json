{
  "_comment": [
    "CLIENT poll policy — deliberately separated from the firmware source",
    "dp_list.def (design concept 13.3). Only changes HOW OFTEN the DatapointPoller",
    "refreshes a value; never the protocol or device semantics.",
    "Realtime = 1 s, Status = 5 s, Config = 60 s, OnConnect = once after",
    "Fountain RUNNING, Disabled = never automatically (explicit read() only).",
    "Network_Password/Backup_Password are Disabled because they are sensitive;",
    "Network_Save/Log_Command are command datapoints and are never polled."
  ],
  "default": "Status",
  "class_intervals_ms": {
    "Realtime": 1000,
    "Status": 5000,
    "Config": 60000
  },
  "datapoints": {
    "Device_Serial_Number": "OnConnect",
    "Device_HW_Version": "OnConnect",
